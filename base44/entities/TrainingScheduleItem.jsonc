      "type": "string"
    },
    "tuesday": {
      "type": "string"
    },
    "wednesday": {
      "type": "string"
    },
    "thursday": {
      "type": "string"
    },
    "friday": {
      "type": "string"
    },
    "field_hours": {
      "type": "number",
