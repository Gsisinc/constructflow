{
  "name": "Product",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Product / service name"
    },
    "sku": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "e.g. devices, cable, labor, service"
    },
    "description": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure: EA, LF, hr, day"
    },
    "sale_price": {
      "type": "number",
      "default": 0
    },
    "cost_price": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0,
      "description": "Sales tax rate (%)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}