{
  "name": "BidEstimate",
  "type": "object",
  "properties": {
    "bid_opportunity_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cost_code": {
            "type": "string",
            "description": "Cost code this line is tagged to (maps to project cost codes)"
          },
          "name": {
            "type": "string",
            "description": "Short line name / label"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_cost": {
            "type": "number"
          },
          "total_cost": {
            "type": "number"
          },
          "category": {
            "type": "string"
          },
          "material_id": {
            "type": "string"
          },
          "pricing_type": {
            "type": "string",
            "enum": [
              "cost",
              "dollar"
            ],
            "default": "cost",
            "description": "cost = raw cost (overhead/profit applied on top); dollar = sell price with margin already included (overhead/profit forced to 0 to avoid double counting)"
          },
          "price_source": {
            "type": "string"
          },
          "quote_ref": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          }
        }
      }
    },
    "labor_hours": {
      "type": "number"
    },
    "labor_rate": {
      "type": "number"
    },
    "labor_cost": {
      "type": "number"
    },
    "material_cost": {
      "type": "number"
    },
    "equipment_cost": {
      "type": "number"
    },
    "subcontractor_cost": {
      "type": "number"
    },
    "crews": {
      "type": "number",
      "default": 1,
      "description": "Number of active crews for supervision calc"
    },
    "weeks": {
      "type": "number",
      "default": 1,
      "description": "Project duration in weeks for supervision calc"
    },
    "supervision_hr_per_week_per_crew": {
      "type": "number",
      "default": 1,
      "description": "Planned supervision hours per week per crew"
    },
    "contingency_percent": {
      "type": "number",
      "default": 10,
      "description": "Contingency % applied to direct cost"
    },
    "contingency_amount": {
      "type": "number",
      "default": 0,
      "description": "Calculated contingency $ (direct cost x contingency %)"
    },
    "overhead_percent": {
      "type": "number",
      "default": 15
    },
    "profit_margin_percent": {
      "type": "number",
      "default": 20
    },
    "subtotal": {
      "type": "number"
    },
    "total_bid_amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "bid_opportunity_id",
    "organization_id"
  ]
}