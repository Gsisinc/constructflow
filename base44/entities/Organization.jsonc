{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#0B1F3A"
    },
    "secondary_color": {
      "type": "string",
      "default": "#1E3A5F"
    },
    "accent_color": {
      "type": "string",
      "default": "#C9A227"
    },
    "industry": {
      "type": "string",
      "enum": [
        "general_contractor",
        "low_voltage",
        "electrical",
        "plumbing",
        "hvac",
        "specialty"
      ],
      "default": "general_contractor"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "professional",
        "enterprise"
      ],
      "default": "starter"
    },
    "owner_email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "date_format": {
      "type": "string",
      "default": "MM/dd/yyyy"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "work_hours_start": {
      "type": "string",
      "default": "08:00"
    },
    "work_hours_end": {
      "type": "string",
      "default": "17:00"
    }
  },
  "required": [
    "name",
    "owner_email"
  ]
}