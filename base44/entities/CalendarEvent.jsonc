{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "calendar_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "all_day": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id",
    "calendar_id",
    "title",
    "start_date"
  ]
}