{
  "name": "Lead",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "referral",
        "website",
        "social_media",
        "advertisement",
        "cold_call",
        "trade_show",
        "other"
      ]
    },
    "project_type": {
      "type": "string"
    },
    "estimated_value": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "proposal_sent",
        "negotiating",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "priority": {
      "type": "string",
      "enum": [
        "cold",
        "warm",
        "hot"
      ],
      "default": "warm"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "converted_to_project_id": {
      "type": "string"
    }
  },
  "required": [
    "contact_name"
  ]
}