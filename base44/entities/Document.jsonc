{
  "name": "Document",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Project this document belongs to (required \u2014 no loose documents)"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "drawing",
        "specification",
        "contract",
        "permit",
        "report",
        "photo",
        "invoice",
        "log",
        "submittal",
        "test_report",
        "other"
      ],
      "description": "Document type"
    },
    "file_url": {
      "type": "string",
      "description": "Private storage URI of the uploaded file"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "superseded"
      ],
      "default": "draft"
    },
    "doc_date": {
      "type": "string",
      "format": "date",
      "description": "Document date"
    },
    "uploaded_by": {
      "type": "string",
      "description": "Name of the uploader"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_id",
    "name",
    "type"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}