{
  "name": "SafetyIncident",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "incident_number": {
      "type": "string",
      "description": "Auto-generated SI-XXXX-XXX"
    },
    "type": {
      "type": "string",
      "enum": [
        "injury",
        "near_miss",
        "property_damage",
        "environmental",
        "security"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "minor",
        "moderate",
        "serious",
        "critical"
      ],
      "default": "moderate"
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "investigating",
        "action_required",
        "resolved",
        "closed"
      ],
      "default": "reported"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "incident_date": {
      "type": "string",
      "format": "date"
    },
    "reported_by": {
      "type": "string"
    },
    "people_involved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "witness_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "witness": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "corrective_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "responsible_party": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    },
    "investigation_notes": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "project_id",
    "type",
    "description",
    "incident_date"
  ]
}