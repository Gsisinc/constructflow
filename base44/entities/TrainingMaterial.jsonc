{
  "name": "TrainingMaterial",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string",
      "description": "Reference to TrainingCourse"
    },
    "module_number": {
      "type": "string",
      "description": "e.g., 2.4"
    },
    "material_type": {
      "type": "string",
      "enum": [
        "presentation",
        "handout",
        "video",
        "practical_kit",
        "exam",
        "lesson_plan"
      ],
      "description": "Type of training material"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Link to uploaded material"
    },
    "duration_minutes": {
      "type": "number",
      "description": "For videos"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "created_by": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organization_id",
    "course_id",
    "material_type",
    "title"
  ]
}