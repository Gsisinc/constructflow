{
  "name": "ChangeOrder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "change_order_number": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "client_request",
        "design_change",
        "unforeseen_conditions",
        "code_compliance",
        "value_engineering",
        "error_correction",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "client_review",
        "approved",
        "rejected",
        "executed"
      ],
      "default": "draft"
    },
    "cost_impact": {
      "type": "number",
      "description": "Positive for increase, negative for decrease"
    },
    "schedule_impact_days": {
      "type": "number",
      "description": "Days added/removed from schedule"
    },
    "scope_description": {
      "type": "string",
      "description": "Impact on project scope"
    },
    "phase_id": {
      "type": "string",
      "description": "Linked CustomPhase this change order affects"
    },
    "phase_name": {
      "type": "string",
      "description": "Display name of the linked phase (denormalized for lists)"
    },
    "entered_by": {
      "type": "string",
      "description": "User who created this change order (email)"
    },
    "entered_date": {
      "type": "string",
      "format": "date",
      "description": "Date the change order was entered"
    },
    "submitted_date": {
      "type": "string",
      "format": "date"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "approved_by": {
      "type": "string"
    },
    "linked_rfi_id": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}