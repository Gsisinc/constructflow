{
  "name": "ChangeOrder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "change_order_number": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "client_request",
        "design_change",
        "unforeseen_conditions",
        "code_compliance",
        "value_engineering",
        "error_correction",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "client_review",
        "approved",
        "rejected",
        "executed"
      ],
      "default": "draft"
    },
    "cost_impact": {
      "type": "number",
      "description": "Positive for increase, negative for decrease"
    },
    "schedule_impact_days": {
      "type": "number",
      "description": "Days added/removed from schedule"
    },
    "scope_description": {
      "type": "string",
      "description": "Impact on project scope"
    },
    "submitted_date": {
      "type": "string",
      "format": "date"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "approved_by": {
      "type": "string"
    },
    "linked_rfi_id": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_id",
    "title"
  ]
}