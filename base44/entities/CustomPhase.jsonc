{
  "name": "CustomPhase",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "phase_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "locked"
      ],
      "default": "not_started"
    },
    "progress_percent": {
      "type": "number",
      "default": 0
    },
    "is_locked": {
      "type": "boolean",
      "default": false
    },
    "is_hidden": {
      "type": "boolean",
      "default": false
    },
    "locked_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Phase planned start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Phase planned end date (shifts when delays are logged)"
    },
    "delays": {
      "type": "array",
      "description": "Logged delays for this phase. Each entry shifts phase dates and the project countdown.",
      "items": {
        "type": "object",
        "properties": {
          "cause": {
            "type": "string"
          },
          "days": {
            "type": "number"
          },
          "logged_date": {
            "type": "string",
            "format": "date"
          },
          "logged_by": {
            "type": "string"
          },
          "old_end": {
            "type": "string",
            "format": "date"
          },
          "new_end": {
            "type": "string",
            "format": "date"
          },
          "old_start": {
            "type": "string",
            "format": "date"
          },
          "new_start": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "project_id",
    "phase_name",
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}