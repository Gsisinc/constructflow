{
  "name": "Issue",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "quality",
        "safety",
        "delay",
        "budget",
        "design",
        "material",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "resolution": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title",
    "type"
  ]
}