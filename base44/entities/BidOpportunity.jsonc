{
  "name": "BidOpportunity",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "project_name": {
      "type": "string",
      "description": "Name of the project"
    },
    "agency": {
      "type": "string",
      "description": "Government agency or organization issuing bid"
    },
    "source": {
      "type": "string",
      "description": "Where the bid opportunity was found"
    },
    "url": {
      "type": "string",
      "description": "Direct link to the bid posting"
    },
    "source_url": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "low_voltage",
        "data_cabling",
        "security_systems",
        "av_systems",
        "fiber_optic",
        "access_control",
        "electrical",
        "hvac",
        "plumbing",
        "general_contractor",
        "other"
      ]
    },
    "division": {
      "type": "string",
      "enum": [
        "fire_alarm",
        "low_voltage",
        "drone",
        "software",
        "other"
      ],
      "description": "Primary division this bid belongs to"
    },
    "lv_domain": {
      "type": "string",
      "enum": [
        "cameras",
        "access_control",
        "structured_cabling",
        "networking",
        "av",
        "monitoring",
        ""
      ],
      "description": "Low-voltage domain (when division is low_voltage)"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_value": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "review",
        "intake",
        "off_pricing",
        "no_bid",
        "user_analyzing",
        "estimated",
        "submitted",
        "won",
        "lost",
        "closed"
      ],
      "default": "review"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "scope_of_work": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "win_probability": {
      "type": "number",
      "description": "Estimated probability of winning (0-100)"
    },
    "owner_id": {
      "type": "string",
      "description": "User who owns/logged this bid"
    },
    "owner_name": {
      "type": "string"
    },
    "attachment_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded bid documents"
    },
    "linked_project_id": {
      "type": "string",
      "description": "Project created when this bid was awarded"
    },
    "linked_estimate_id": {
      "type": "string",
      "description": "Current estimate linked to this bid"
    },
    "notes": {
      "type": "string"
    },
    "ai_analysis": {
      "type": "object",
      "properties": {
        "complexity_score": {
          "type": "number"
        },
        "recommended_markup": {
          "type": "number"
        },
        "risk_factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "similar_projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}