{
  "name": "TechnicianCertification",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "technician_email": {
      "type": "string"
    },
    "technician_name": {
      "type": "string"
    },
    "certification_id": {
      "type": "string",
      "description": "Reference to IndustryCertification"
    },
    "cert_name": {
      "type": "string"
    },
    "date_earned": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Null if no renewal needed"
    },
    "cert_number": {
      "type": "string",
      "description": "Certificate number for reference"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Certificate document verified"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "expiring_soon",
        "expired",
        "pending"
      ],
      "default": "pending"
    },
    "document_url": {
      "type": "string",
      "description": "Link to uploaded certificate"
    }
  },
  "required": [
    "organization_id",
    "technician_email",
    "certification_id"
  ]
}