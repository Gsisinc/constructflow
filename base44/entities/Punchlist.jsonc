{
  "name": "Punchlist",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "item_number": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "deficiency",
        "incomplete_work",
        "correction",
        "touch_up",
        "cleanup",
        "other"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed",
        "verified",
        "closed"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string"
    },
    "responsible_contractor": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "photo_before": {
      "type": "string"
    },
    "photo_after": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "description"
  ]
}